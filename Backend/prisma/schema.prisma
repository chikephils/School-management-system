generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_ADMIN
  LECTURER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum SemesterType {
  FIRST
  SECOND
}

enum CourseCategory {
  CORE
  ELECTIVE
}

enum CourseRegistrationType {
  NORMAL
  CARRYOVER
  SPILLOVER
}

enum StaffTitle {
  MR
  MRS
  MISS
  MS
  DR
  PROF
  ASSOCIATE_PROF
}

enum ProgrammeAward {
  BSC
  BA
  BED
  LLB
  MBBS
  BDS
  PharmD
  BNSC
  BMLS
  MSC
  MA
  MBA
  PHD
  PGD
}

enum CourseGrade {
  A
  B
  C
  D
  E
  F
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
}

enum CourseOfferingScope {
  UNIVERSITY
  ACADEMIC_CATEGORY
  FACULTY
  DEPARTMENT
  PROGRAMME
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
}

model StudentProfile {
  id                  String               @id @default(uuid())
  userId              String               @unique
  matricNumber        String               @unique
  firstName           String
  lastName            String
  otherName           String?
  gender              Gender
  dateOfBirth         DateTime
  phoneNumber         String
  profileImageUrl     String
  faculty             String
  department          String
  programme           String
  programmeId         String?
  level               Int
  admissionLevel      Int                  @default(100)
  admissionYear       Int
  courseRegistrations CourseRegistration[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  programmeRecord Programme? @relation("StudentProgramme", fields: [programmeId], references: [id])
}

model StaffProfile {
  id              String     @id @default(uuid())
  userId          String     @unique
  staffNumber     String     @unique
  email           String     @unique
  title           StaffTitle
  firstName       String
  lastName        String
  otherName       String?
  phoneNumber     String
  profileImageUrl String
  faculty         String?
  department      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lecturerCourseOfferings CourseOffering[] @relation("LecturerCourseOfferings")

  updatedScores CourseRegistration[] @relation("ScoreUpdatedBy")
}

model AcademicCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculties               Faculty[]
  courseOfferingAudiences CourseOfferingAudience[]
}

model Faculty {
  id                 String           @id @default(uuid())
  name               String           @unique
  code               String           @unique
  departments        Department[]
  academicCategoryId String
  academicCategory   AcademicCategory @relation(fields: [academicCategoryId], references: [id], onDelete: Restrict)

  courseOfferingAudiences CourseOfferingAudience[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Department {
  id                      String                   @id @default(uuid())
  facultyId               String
  name                    String
  code                    String                   @unique
  faculty                 Faculty                  @relation(fields: [facultyId], references: [id])
  programmes              Programme[]
  courses                 Course[]
  courseOfferingAudiences CourseOfferingAudience[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Programme {
  id                      String                   @id @default(uuid())
  departmentId            String
  name                    String
  code                    String                   @unique
  award                   ProgrammeAward
  durationYears           Int                      @default(4)
  department              Department               @relation(fields: [departmentId], references: [id])
  courseOfferingAudiences CourseOfferingAudience[]
  students                StudentProfile[]         @relation("StudentProgramme")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model AcademicSession {
  id        String             @id @default(uuid())
  name      String             @unique
  isCurrent Boolean            @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  semesters AcademicSemester[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model AcademicSemester {
  id                String           @id @default(uuid())
  academicSessionId String
  type              SemesterType
  isCurrent         Boolean          @default(false)
  registrationOpen  Boolean          @default(false)
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id])
  courseOfferings   CourseOffering[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([academicSessionId, type])
}

model Course {
  id           String           @id @default(uuid())
  departmentId String
  code         String           @unique
  title        String
  creditUnit   Int
  level        Int
  category     CourseCategory
  department   Department       @relation(fields: [departmentId], references: [id])
  offerings    CourseOffering[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model CourseOffering {
  id                 String  @id @default(uuid())
  courseId           String
  academicSemesterId String
  lecturerId         String?

  scope            CourseOfferingScope
  level            Int
  registrationOpen Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicSemester AcademicSemester @relation(fields: [academicSemesterId], references: [id], onDelete: Cascade)
  lecturer         StaffProfile?    @relation("LecturerCourseOfferings", fields: [lecturerId], references: [id])

  audiences     CourseOfferingAudience[]
  registrations CourseRegistration[]
}

model CourseOfferingAudience {
  id               String @id @default(uuid())
  courseOfferingId String

  academicCategoryId String?
  facultyId          String?
  departmentId       String?
  programmeId        String?

  createdAt DateTime @default(now())

  courseOffering   CourseOffering    @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  academicCategory AcademicCategory? @relation(fields: [academicCategoryId], references: [id], onDelete: Cascade)
  faculty          Faculty?          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programme        Programme?        @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([courseOfferingId, academicCategoryId])
  @@unique([courseOfferingId, facultyId])
  @@unique([courseOfferingId, departmentId])
  @@unique([courseOfferingId, programmeId])
}

model CourseRegistration {
  id               String                 @id @default(uuid())
  studentProfileId String
  courseOfferingId String
  type             CourseRegistrationType @default(NORMAL)
  status           RegistrationStatus     @default(DRAFT)
  registeredAt     DateTime               @default(now())
  submittedAt      DateTime?

  caScore          Float?
  examScore        Float?
  totalScore       Float?
  grade            CourseGrade?
  gradePoint       Float?
  scoreUpdatedAt   DateTime?
  scoreUpdatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  scoreUpdatedBy StaffProfile? @relation("ScoreUpdatedBy", fields: [scoreUpdatedById], references: [id])

  @@unique([studentProfileId, courseOfferingId])
}
